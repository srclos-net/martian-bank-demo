{
  "dashboard": {
    "id": null,
    "uid": "faro-rum-generic",
    "title": "Faro \u2014 Frontend (RUM) by Application",
    "description": "Generic Faro/web-RUM stats: pick any application (Loki service_name emitted by the faro->relay pipeline) to see event volume, errors, recent logs and browser traces. Data via https://faro.stackgen.run -> data-recipes-traces-relay -> ObserveNow.",
    "tags": [
      "faro",
      "rum",
      "fe-stackgen-run"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "app",
          "label": "Application",
          "type": "query",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "query": {
            "query": "label_values({}, service_name)",
            "refId": "var"
          },
          "refresh": 2,
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "current": {
            "text": "All",
            "value": "$__all"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "title": "Overview",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "refId": "s0",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "sum(count_over_time({service_name=~\"$app\"}[$__range]))",
            "queryType": "range",
            "instant": false
          }
        ],
        "gridPos": {
          "h": 3,
          "w": 8,
          "x": 0,
          "y": 1
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Error events",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "refId": "s1",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "sum(count_over_time({service_name=~\"$app\"} |= \"error\" | logfmt [$__range]))",
            "queryType": "range",
            "instant": false
          }
        ],
        "gridPos": {
          "h": 3,
          "w": 8,
          "x": 8,
          "y": 1
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "red"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Pages seen",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "refId": "s2",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "count(sum by (page_url_line) (count_over_time({service_name=~\"$app\"} [$__range])))",
            "queryType": "range",
            "instant": false
          }
        ],
        "gridPos": {
          "h": 3,
          "w": 8,
          "x": 16,
          "y": 1
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        }
      },
      {
        "id": 10,
        "type": "row",
        "title": "Activity",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 4
        }
      },
      {
        "id": 11,
        "type": "timeseries",
        "title": "RUM event volume by app",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "sum by (service_name) (rate({service_name=~\"$app\"}[$__interval]))",
            "queryType": "range",
            "instant": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 5
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "fillOpacity": 20,
              "lineWidth": 2
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "max"
            ]
          }
        }
      },
      {
        "id": 12,
        "type": "timeseries",
        "title": "RUM errors by app",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "sum by (service_name) (rate({service_name=~\"$app\"} |= \"error\" | logfmt [$__interval]))",
            "queryType": "range",
            "instant": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 5
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "fillOpacity": 20,
              "lineWidth": 2,
              "lineInterpolation": "smooth"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "max",
              "lastNotNull"
            ]
          }
        }
      },
      {
        "id": 20,
        "type": "row",
        "title": "Traces (web-vitals measurements & sessions)",
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 13
        }
      },
      {
        "id": 21,
        "type": "table",
        "title": "Recent browser traces",
        "datasource": {
          "type": "jaeger",
          "uid": "jaeger"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "jaeger",
              "uid": "jaeger"
            },
            "queryType": "search",
            "search": {
              "serviceName": "${app:sqlparam}"
            }
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        },
        "options": {
          "showHeader": true
        },
        "transformations": []
      },
      {
        "id": 22,
        "type": "logs",
        "title": "Recent RUM logs (sample)",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "{service_name=~\"$app\"}",
            "queryType": "range",
            "instant": false
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "sortOrder": "Descending",
          "wrapLines": false
        }
      }
    ]
  },
  "overwrite": true
}